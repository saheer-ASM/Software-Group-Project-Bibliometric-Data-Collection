# Copy this file to .env and fill in your own values. .env is gitignored.

# Puts OpenAlex requests in the faster "polite pool". Any real address works.
OPENALEX_MAILTO=you@example.com

# Optional but strongly recommended: raises the daily OpenAlex budget from
# $0.10 to $1.00. This script uses search= calls (10x the cost of a plain
# filter call), so ~917 authors needs the larger budget to finish in one run.
# Get a free key at https://openalex.org/settings/api
OPENALEX_API_KEY=

# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=1jUeItK_UrAaPwdJUnwpMikkqy3zqfaNHPmVkRx4-pXs

# Name of the tab this script creates/fills. Matches the `author` table name
# used by scripts_db/migrate.py, so the Sheet and the eventual AWS database
# stay consistent.
GOOGLE_SHEET_TAB=author

# Path to the service-account key you downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
