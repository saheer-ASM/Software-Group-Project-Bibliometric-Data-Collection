# Copy to .env and fill in. .env is gitignored -- never commit your real key.
# Get a free key (no payment method needed) at https://openalex.org/settings/api
# A key raises your daily allowance from $0.10 to $1.00 -- about 10x the authors
# you can collect per day.
OPENALEX_API_KEY=
# Optional: your own address, used for OpenAlex's "polite pool".
OPENALEX_MAILTO=
