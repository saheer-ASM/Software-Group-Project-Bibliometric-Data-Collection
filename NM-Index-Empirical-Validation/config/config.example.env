# postgresql (default) uses the DB_HOST..DB_SSLMODE values below.
# sqlite opens DB_PATH read-only and ignores them, e.g.
# DB_PATH=../OpenAlex_Data_Collection/database/openalex.db
DB_ENGINE=
DB_PATH=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

# Optional validation settings; values are examples, not methodological approvals.
VALIDATION_AS_OF_DATE=
MIN_PUBLICATIONS=
MIN_RAW_CITES=
MIN_METRIC_COVERAGE=
RANDOM_SEED=
OUTPUT_DIRECTORY=
