REACT_APP_API_URL=http://localhost:5005

# Firebase web app config (public client identifiers, not secrets; still kept out of the code)
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
# Restart `npm start` after changing this file; CRA reads it only at startup.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional, local testing only: use the Firebase emulators instead of the real project.
# REACT_APP_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# REACT_APP_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
