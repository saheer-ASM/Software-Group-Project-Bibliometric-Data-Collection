# Copy this file to .env at the REPOSITORY ROOT and fill in your values.
# This root .env serves the Python research pipeline and local development.
#
# PRODUCTION DOES NOT USE THIS FILE. The Docker stack reads production/.env:
#   docker compose --env-file production/.env -f production/compose.yaml up -d --build
# See production/.env for the full production variable list.

# =====================================================================
# PostgreSQL -- used by the Python pipeline AND the backend
# =====================================================================
# Quote any value containing '#', or everything after it is dropped.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Production uses the same names (DB_HOST, DB_PORT, ...) in production/.env,
# pointing at the remote AWS server. No production-only aliases exist.

# =====================================================================
# Backend session tokens (server-side secret -- never sent to the browser)
# =====================================================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional for local development; the production container sets it to 5005.
PORT=5005

# =====================================================================
# Firebase Admin SDK -- SERVER-SIDE ONLY, never passed to the frontend
# =====================================================================
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key, then base64-encode the JSON:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("backend/serviceAccountKey.json"))
#   macOS/Linux: base64 -i backend/serviceAccountKey.json
# Base64 is what production uses, so no key file is ever baked into an image.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Local-development alternative (path relative to backend/):
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# =====================================================================
# CORS
# =====================================================================
# http://localhost:<port> is always allowed, so development needs nothing here.
# Behind nginx the browser is same-origin, but fetch() still sends an Origin
# header on POST, so list your real domain in production.
# Comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://your-domain.example

# =====================================================================
# Firebase WEB app config -- baked into the browser bundle at BUILD time
# =====================================================================
# Create React App inlines REACT_APP_* at build time, so these end up readable
# in the shipped JavaScript. That is fine: they are public client identifiers
# that ship in every Firebase web app, protected by Firebase security rules
# rather than secrecy.
# NEVER add DB_*, JWT_SECRET or FIREBASE_SERVICE_ACCOUNT_* with a REACT_APP_
# prefix -- that would publish them to every visitor.
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# REACT_APP_API_URL is intentionally NOT set here. Production pins it to ""
# in production/compose.yaml so the bundle calls the relative path /api/...,
# same-origin through nginx. In development the CRA proxy in
# frontend/package.json forwards to http://localhost:5005.
