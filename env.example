# Copy this file to .env and fill in your values

# Firebase service account credentials
# Recommended: put the whole service account JSON in base64 form here.
# Generate the JSON in Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Then run: base64 -i serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json

# Alternative to FIREBASE_SERVICE_ACCOUNT_BASE64:
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT secret key — use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here

# Token expiry (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Port (optional, defaults to 5000)
PORT=5001
