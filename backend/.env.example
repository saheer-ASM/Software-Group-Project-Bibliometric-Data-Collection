# Copy this file to .env and fill in your values. Never commit .env or the key file.

# --- Firebase Admin SDK (verifies Firebase ID tokens, stores user profiles in Firestore) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Use ONE of the three options below.

# Option 1 (local development): path to the downloaded key file, relative to backend/
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option 2 (recommended for deployment): the whole key JSON, base64-encoded
#   macOS/Linux:  base64 -i serviceAccountKey.json
#   PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option 3: individual fields from the key JSON
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Bibliometric data: the OpenAlex pipeline's local SQLite database ---
# Read where it is, read-only: the backend never writes to it. Leave unset to use
# ../OpenAlex_Data_Collection/database/openalex.db; a relative path is resolved
# from backend/. Needs Node.js 22.13 or newer (the built-in node:sqlite module).
# OPENALEX_DB_PATH=

# Optional: queries run on DB_WORKERS threads, so a slow one never freezes the
# server. More than DB_MAX_QUEUE waiting queries, or a wait longer than
# DB_QUERY_TIMEOUT_MS, answers 503 instead of piling up.
# DB_WORKERS=2
# DB_MAX_QUEUE=64
# DB_QUERY_TIMEOUT_MS=90000

# --- Backend session tokens ---
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

PORT=5005

# Optional, local testing only: Firebase Auth emulator (no credentials; profiles kept in memory)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_EMULATOR_PROJECT_ID=your_project_id
